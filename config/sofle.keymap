#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_lr {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <55 43 56 44 30 18 6 7 19 31 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 46 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 56 57 58 59 54 53 52>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 55 56 57>;
        };

        bhm_dot_apos: bhm_dot_apos {
            compatible = "zmk,behavior-mod-morph";
            label = "BHM_DOT_APOS";
            bindings = <&kp DOT>, <&kp APOS>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        bhm_fwdslsh_bckslsh: bhm_fwdslsh_bckslsh {
            compatible = "zmk,behavior-mod-morph";
            label = "BHM_FWDSLSH_BCKSLSH";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        bh_bcksp_del: bh_bcksp_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BH_BCKSP_DEL";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lang {
            bindings = <&kp LA(LC(SPACE))>;
            key-positions = <37 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&none           &none  &none  &none             &none         &none                                     &none  &none                       &none              &none                 &none                  &none
&kp ESC         &kp Q  &kp W  &kp E             &kp R         &kp T                                     &kp Y  &kp U                       &kp I              &kp O                 &kp P                  &bh_bcksp_del
&kp TAB         &kp A  &kp S  &kp D             &kp F         &kp G                                     &kp H  &hmr RIGHT_GUI J            &hmr RALT K        &hmr RIGHT_CONTROL L  &hmr RIGHT_SHIFT SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V         &kp B         &kp C_MUTE     &kp ENTER    &kp N  &kp M                       &kp COMMA          &kp DOT               &kp SLASH              &kp BACKSLASH
                       &none  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE    &lt 3 ENTER  &mo 2  &mt RIGHT_ALT LEFT_BRACKET  &kp RIGHT_BRACKET  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "Navigation";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none  &none      &none      &none     &none           &none                              &none            &none         &none                &none            &none             &none
&none  &kp GRAVE  &kp UNDER  &none     &kp LPAR        &kp RPAR                           &kp PAGE_UP      &kp HOME      &kp UP_ARROW         &kp END          &kp INS           &none
&none  &kp EQUAL  &kp MINUS  &kp PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE                    &kp PAGE_DOWN    &kp LEFT      &kp DOWN_ARROW       &kp RIGHT_ARROW  &kp CAPS          &none
&none  &none      &none      &none     &kp LEFT_BRACE  &kp RIGHT_BRACE  &none     &none   &kp PRINTSCREEN  &kp LA(LEFT)  &kp LA(RIGHT_ARROW)  &kp LESS_THAN    &kp GREATER_THAN  &none
                  &none      &none     &trans          &trans           &trans    &trans  &trans           &trans        &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "Navigation";
        };

        nmbr_layer {
            display-name = "Number";
            bindings = <
&none   &none         &none         &none         &none         &none                           &none   &none   &none   &none    &none    &none
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                    &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0                          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &none         &none         &none         &none         &none         &none     &none   &none   &none   &none   &none    &none    &trans
                      &none         &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;

            label = "Number";
        };

        puntctn_layer {
            bindings = <
&trans  &trans     &trans    &trans    &trans    &trans                       &trans          &trans           &trans            &trans             &trans         &trans
&trans  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                    &kp LPAR        &kp RPAR         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR                     &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans            &kp SEMI           &kp SQT        &trans
&trans  &trans     &trans    &trans    &trans    &trans     &trans    &trans  &trans          &trans           &kp COMMA         &kp DOT            &kp SLASH      &trans
                   &trans    &trans    &trans    &trans     &trans    &trans  &trans          &trans           &trans            &trans
            >;

            label = "Punctuation";
        };

        bth_layer {
            display-name = "Bluetooth";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans                    &trans  &trans        &trans          &trans        &trans        &trans
&bootloader  &trans  &trans  &trans  &trans  &trans                    &trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &bootloader
&trans       &trans  &trans  &trans  &trans  &trans                    &trans  &trans        &trans          &trans        &trans        &trans
&sys_reset   &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &trans
                     &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans        &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "Bloetooth";
        };
    };
};
